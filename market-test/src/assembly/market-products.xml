<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0">
  <id>market</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.build.directory}/market</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>products/*/*.json</include>
        <include>products/*/logo*.png</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>